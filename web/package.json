{
  "name": "agentobs-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript ${API_DOCS_URL:-http://localhost:8080/v3/api-docs} -o src/api/schema.ts",
    "check:api": "openapi-typescript ${API_DOCS_URL:-http://localhost:8080/v3/api-docs} -o /tmp/schema.ts && diff -q /tmp/schema.ts src/api/schema.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@tanstack/react-query": "5.66.0",
    "@tanstack/react-table": "8.21.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "5.6.0",
    "lucide-react": "0.474.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.1.5",
    "tailwind-merge": "3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.13.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.19.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "26.0.0",
    "openapi-fetch": "0.13.4",
    "openapi-typescript": "7.6.1",
    "tailwindcss": "4.1.11",
    "typescript": "5.7.3",
    "typescript-eslint": "8.22.0",
    "vite": "6.0.11",
    "vitest": "3.0.5"
  }
}
