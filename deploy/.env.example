# ---- Postgres ----
POSTGRES_PASSWORD=change-me-postgres
AGENTOBS_SERVER_DB_PASSWORD=change-me-server
AGENTOBS_PIPELINE_DB_PASSWORD=change-me-pipeline
AGENTOBS_TRIAGE_DB_PASSWORD=change-me-triage

# ---- server ----
AGENTOBS_INGEST_TOKEN=change-me-ingest-token
AGENTOBS_INTERNAL_TOKEN=change-me-internal-token
AGENTOBS_RETENTION_DAYS=90

# ---- LLM (空 = mock) ----
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
S1_MODEL=
S2_MODEL=

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---- demo ----
DEMO_RATE=6/min
DEMO_SEED=42

# ---- RabbitMQ（可选，M6）----
# 启用：docker compose --profile rabbitmq …，并把下面两个 *_QUEUE_URL 取消注释。
# 不设置时 worker 和 demo 默认用 pgmq。
RABBITMQ_ADMIN_USER=agentobs_admin
RABBITMQ_ADMIN_PASSWORD=change-me-rabbitmq-admin
AGENTOBS_PIPELINE_MQ_PASSWORD=change-me-pipeline-mq
AGENTOBS_TRIAGE_MQ_PASSWORD=change-me-triage-mq
# AGENTOBS_PIPELINE_QUEUE_URL=amqp://agentobs_pipeline:change-me-pipeline-mq@rabbitmq:5672/%2F
# AGENTOBS_TRIAGE_QUEUE_URL=amqp://agentobs_triage:change-me-triage-mq@rabbitmq:5672/%2F

# ---- Langfuse（可选，M6）----
# 用法：docker compose -f compose.yaml -f compose.langfuse.yaml …（或 make demo-langfuse）
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- 端口（宿主机）----
AGENTOBS_WEB_PORT=8088
GRAFANA_PORT=3000
