{
  "uid": "agentobs-llm",
  "title": "agentobs / LLM 调用",
  "tags": ["agentobs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "stage", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(agentobs_llm_requests_total, stage)", "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}},
      {"name": "model", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(agentobs_llm_requests_total, model)", "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}}
    ]
  },
  "panels": [
    {"id": 1, "type": "timeseries", "title": "请求量 / s", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (stage, model, status) (rate(agentobs_llm_requests_total{stage=~\"$stage\", model=~\"$model\"}[5m]))", "legendFormat": "{{stage}} {{model}} {{status}}"}]},
    {"id": 2, "type": "timeseries", "title": "P95 延迟 (s)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le, stage, model) (rate(agentobs_llm_latency_seconds_bucket{stage=~\"$stage\", model=~\"$model\"}[5m])))", "legendFormat": "{{stage}} {{model}}"}]},
    {"id": 3, "type": "timeseries", "title": "token / s", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (stage, model, direction) (rate(agentobs_llm_tokens_total{stage=~\"$stage\", model=~\"$model\"}[5m]))", "legendFormat": "{{stage}} {{model}} {{direction}}"}]},
    {"id": 4, "type": "timeseries", "title": "成本 USD / h", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
     "targets": [{"expr": "sum by (stage, model) (rate(agentobs_llm_cost_usd_total{stage=~\"$stage\", model=~\"$model\"}[5m])) * 3600", "legendFormat": "{{stage}} {{model}}"}]},
    {"id": 5, "type": "timeseries", "title": "重试 / s（按原因）", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (stage, reason) (rate(agentobs_llm_retries_total{stage=~\"$stage\"}[5m]))", "legendFormat": "{{stage}} {{reason}}"}]},
    {"id": 6, "type": "stat", "title": "进行中 / 最老 job 秒数", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"expr": "agentobs_jobs_in_progress", "legendFormat": "in progress"},
       {"expr": "agentobs_job_oldest_in_progress_seconds", "legendFormat": "oldest (s)"}
     ]}
  ]
}
